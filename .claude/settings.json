{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(lint-imports *)",
      "Bash(pre-commit run *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(sha256sum *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(/ethera-eval-core/tests/integration/registry/_contract_fixtures.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/_registry_oracle.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/conftest.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_manifest_concurrency.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_manifest_refusals.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_manifest_replace.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_manifest_validation_document.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_manifest_validation_schema.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_product_read.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_products_list.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_registry_audit.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_registry_never_log.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_registry_seed.py)",
      "Edit(/ethera-eval-core/tests/integration/registry/test_registry_tenancy.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_edited.py\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_checks.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
