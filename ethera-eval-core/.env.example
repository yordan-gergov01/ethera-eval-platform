# Example environment for ethera-eval-core.
#
# Copy it to .env (which Git ignores) and adjust the values:
#   cp .env.example .env
#
# Every value here is a placeholder for local development only. Replace all
# secrets and credentials before any shared or production use.
#
# Variables are added here together with the code that reads them.

# --- PostgreSQL --------------------------------------------------------------
# Database credentials are applied only when the data volume is first created.
# After changing them, reset the volume: docker compose down -v
POSTGRES_DB=ethera_eval
# Superuser: used only inside the postgres container for initialisation.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-change-me-superuser
# Migration owner: owns the database and schema, runs migrations and seeds at
# startup, holds BYPASSRLS; no superuser rights.
POSTGRES_OWNER_USER=ethera_eval_owner
POSTGRES_OWNER_PASSWORD=dev-only-change-me-owner
# Runtime role: serves every request with data grants only, row security applies
# (NOBYPASSRLS); owns nothing.
POSTGRES_APP_USER=ethera_eval_app
POSTGRES_APP_PASSWORD=dev-only-change-me-app

# --- RabbitMQ ----------------------------------------------------------------
# Users and permissions are applied on every broker start. There is no "guest" user.
RABBITMQ_VHOST=ethera_eval
# Backend: publishes jobs, consumes results and the job dead-letter queue.
RABBITMQ_BACKEND_USER=backend
RABBITMQ_BACKEND_PASSWORD=dev-only-change-me-backend
# Runner: consumes jobs, publishes results.
RABBITMQ_RUNNER_USER=runner
RABBITMQ_RUNNER_PASSWORD=dev-only-change-me-runner
# Read-only access to the dead-letter queues for inspection (see README).
RABBITMQ_INSPECTOR_USER=inspector
RABBITMQ_INSPECTOR_PASSWORD=dev-only-change-me-inspector
# Unacknowledged messages each consumer may hold at once.
RABBITMQ_PREFETCH_COUNT=10

# --- Backend -----------------------------------------------------------------
# Host port of the API. A range such as 8000-8001 gives each replica its own port
# when scaling with: docker compose up -d --scale backend=2
BACKEND_PORT=8000
# Connections per backend replica. Replicas x pool size must stay below
# PostgreSQL's max_connections (100 by default).
DB_POOL_MAX_SIZE=10
# Signing key for access tokens, at least 32 bytes. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-this-not-a-real-signing-key-0000
# Lifetime of an access token in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Admin account created on the first start if it does not exist yet. It is never
# updated afterwards: change the password through the API, not here.
# The password must be 12-128 characters and not a common password.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-only-change-this-admin-password
# Interactive API documentation at /docs.
ENABLE_API_DOCS=true
# Comma-separated frontend origins allowed by CORS. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Larger request bodies are rejected with 413.
MAX_REQUEST_BODY_BYTES=1048576
# Comma-separated addresses or networks (CIDR) of reverse proxies whose
# X-Forwarded-For header is trusted. Empty: the connecting address is the client.
TRUSTED_PROXIES=

# --- Rate limiting -----------------------------------------------------------
# Requests per window for every /api/v1 request, per user (valid token) or per IP.
RATE_LIMIT_DEFAULT_REQUESTS=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
# Login attempts per window, per client IP and username.
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# json (containers) or console (readable local output).
LOG_FORMAT=json
