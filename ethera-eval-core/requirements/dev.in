# Local development and test tooling, on top of the services' dependencies (backend, runner,
# demo target).
# The constraints keep shared packages at the versions the services use.
-r backend.in
-r runner.in
-r demo_target.in
-c backend.txt
-c runner.txt
-c demo_target.txt

uv
ruff
mypy
pytest
pytest-asyncio
# Coverage measurement for the coverage gates (docs/DECISIONS.md D-008).
pytest-cov
httpx
import-linter
pre-commit
# Reads docker-compose.yml in the configuration drift test.
pyyaml
# Type information for libraries that ship none.
asyncpg-stubs
types-pyyaml
