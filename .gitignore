docs/Claude_Code_Bible.md

# Environment files with real values; .env.example files are committed.
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Claude Code local state
.claude/settings.local.json
.claude/edited.log
